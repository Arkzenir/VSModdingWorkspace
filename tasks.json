{
    "version": "2.0.0",
    "tasks": [

        // ── Build ────────────────────────────────────────────────────────────
        // Ctrl+Shift+B runs the default build task (WS: Build Debug)
        {
            "label": "WS: Build Debug",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 build",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "WS: Build Release",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 build release",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": "$msCompile"
        },

        // ── Mod management ───────────────────────────────────────────────────
        {
            "label": "WS: New Mod",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 new-mod '${input:newModName}'",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "WS: Import Mod",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 import-mod '${input:importModSource}'",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "WS: Set Active Mod",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 use-mod '${input:useModName}'",
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "WS: List Mods",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 list-mods",
            "presentation": { "reveal": "always", "panel": "shared" }
        },

        // ── API and game source ──────────────────────────────────────────────
        {
            "label": "WS: Fetch API Version",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 fetch-api ${input:apiVersion}",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "WS: Fetch Game Source (Essentials)",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 fetch-gamesrc essentials",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "WS: Fetch Game Source (Survival)",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 fetch-gamesrc survival",
            "presentation": { "reveal": "always", "panel": "shared" }
        },

        // ── Git workflow ─────────────────────────────────────────────────────
        {
            "label": "WS: Publish Mod (branch in this repo)",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 publish-mod",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "WS: Export Mod (standalone repo)",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 export-mod '${input:exportRemoteUrl}'",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "WS: Reset Workspace",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 reset",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "WS: Publish and Reset (full end-of-session)",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 publish-mod; .\\scripts\\vs-workspace.ps1 reset",
            "presentation": { "reveal": "always", "panel": "shared" }
        },

        // ── Workspace info ───────────────────────────────────────────────────
        {
            "label": "WS: Status",
            "type": "shell",
            "command": ".\\scripts\\vs-workspace.ps1 status",
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ],

    "inputs": [
        {
            "id": "newModName",
            "type": "promptString",
            "description": "Mod name (PascalCase, e.g. MyMod)"
        },
        {
            "id": "importModSource",
            "type": "promptString",
            "description": "Local folder path, .zip file, or git URL"
        },
        {
            "id": "useModName",
            "type": "promptString",
            "description": "Mod folder name to set as active target"
        },
        {
            "id": "apiVersion",
            "type": "promptString",
            "description": "VS version to fetch (e.g. 1.21.5)"
        },
        {
            "id": "exportRemoteUrl",
            "type": "promptString",
            "description": "Remote git URL for standalone repo (leave empty to only init locally)"
        }
    ]
}
